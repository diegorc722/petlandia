# ============================================================
# PETLANDIA - Variables de entorno (plantilla)
# Copia este archivo a `.env` y completa los valores.
# NO subas el archivo `.env` real al repositorio.
# ============================================================

# --- Aplicación ---
APP_NAME=PetLandia
APP_ENV=development
APP_URL=http://petlandia.local

# --- Base de datos ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=petlandia
DB_USER=root
DB_PASSWORD=TU_CONTRASEÑA_AQUI

# --- Sesiones ---
SESSION_NAME=PETLANDIA_SESSION
